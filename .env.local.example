# Copy to .env.local and fill in. Never commit the filled-in file.
#
# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service role key. Server-side only — it bypasses row level security and
# must never be exposed to the browser. Every database call in this app goes
# through an API route for exactly this reason.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail ingestion (optional) --------------------------------------------
# Only needed for automatic bank-alert scanning. Leave blank to use manual
# entry and the Apple Shortcut instead; the rest of the app works without it.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- App passphrase (required in production) --------------------------------
# The app has no accounts; one passphrase gates every page and API route.
# Leave blank locally to run without a sign-in screen. In production it is
# required — a deployment without it refuses to serve rather than sitting open.
# Headless callers (the Apple Shortcut) send it as: Authorization: Bearer <value>
# Generate one with (works on Mac, Windows and Linux):
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
APP_PASSPHRASE=

# --- Cron (required in production) -----------------------------------------
# Any long random string. Authenticates the daily scan job.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
